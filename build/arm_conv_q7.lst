 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* conv(x,y) at n = x[n] * y[0] + x[n-1] * y[1] + x[n-2] * y[2] + ...+ x[n-N+1] * y[N -1] */
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* The function is internally
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * divided into three stages according to the number of multiplications that has to be
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * taken place between inputA samples and inputB samples. In the first stage of the
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * algorithm, the multiplications increase by one for every iteration.
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * In the second stage of the algorithm, srcBLen number of multiplications are done.
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * In the third stage of the algorithm, the multiplications decrease by one
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * for every iteration. */
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* The algorithm is implemented in three stages.
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccUuHaIa.s 			page 4


 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****      The loop counters of each stage is initiated here. */
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   blockSize1 = srcBLen - 1U;
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   blockSize2 = (srcALen - srcBLen) + 1U;
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   blockSize3 = blockSize1;
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* --------------------------
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * Initializations of stage1
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * -------------------------*/
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* sum = x[0] * y[0]
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * sum = x[0] * y[1] + x[1] * y[0]
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * ....
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * sum = x[0] * y[srcBlen - 1] + x[1] * y[srcBlen - 2] +...+ x[srcBLen - 1] * y[0]
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    */
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* In this stage the MAC operations are increased by 1 for every iteration.
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****      The count variable holds the number of MAC operations performed */
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   count = 1U;
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* Working pointer of inputA */
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   px = pIn1;
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* Working pointer of inputB */
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   py = pIn2;
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* ------------------------
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * Stage1 process
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****    * ----------------------*/
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* The first stage starts here */
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   while (blockSize1 > 0U)
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   {
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* Accumulator is made zero for every iteration */
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     sum = 0;
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* Apply loop unrolling and compute 4 MACs simultaneously. */
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     k = count >> 2U;
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* First part of the processing with loop unrolling.  Compute 4 MACs at a time.
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****      ** a second loop below computes MACs for the remaining 1 to 3 samples. */
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     while (k > 0U)
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     {
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       /* x[0] , x[1] */
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in1 = (q15_t) * px++;
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in2 = (q15_t) * px++;
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       input1 = ((q31_t) in1 & 0x0000FFFF) | ((q31_t) in2 << 16U);
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       /* y[srcBLen - 1] , y[srcBLen - 2] */
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in1 = (q15_t) * py--;
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in2 = (q15_t) * py--;
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       input2 = ((q31_t) in1 & 0x0000FFFF) | ((q31_t) in2 << 16U);
 176:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 177:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       /* x[0] * y[srcBLen - 1] */
 178:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       /* x[1] * y[srcBLen - 2] */
 179:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       sum = __SMLAD(input1, input2, sum);
 180:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccUuHaIa.s 			page 5


 181:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       /* x[2] , x[3] */
 182:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in1 = (q15_t) * px++;
 183:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in2 = (q15_t) * px++;
 184:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       input1 = ((q31_t) in1 & 0x0000FFFF) | ((q31_t) in2 << 16U);
 185:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 186:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       /* y[srcBLen - 3] , y[srcBLen - 4] */
 187:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****       in1 = (q15_t) * py--;
