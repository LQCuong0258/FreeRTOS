  76:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
  77:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t *pIn1;                                    /* inputA pointer */
  78:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t *pIn2;                                    /* inputB pointer */
  79:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t *pOut = pDst;                             /* output pointer */
  80:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t *px;                                      /* Intermediate inputA pointer */
  81:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t *py;                                      /* Intermediate inputB pointer */
  82:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t *pSrc1, *pSrc2;                           /* Intermediate pointers */
  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q7_t x0, x1, x2, x3, c0, c1;                   /* Temporary variables to hold state and coefficie
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q31_t sum, acc0, acc1, acc2, acc3;             /* Accumulator */
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q31_t input1, input2;                          /* Temporary input variables */
  86:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   q15_t in1, in2;                                /* Temporary input variables */
  87:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   uint32_t j, k, count, blkCnt, blockSize1, blockSize2, blockSize3;     /* loop counter */
  88:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* srcB is always made to slide across srcA. */
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   if (srcALen >= srcBLen)
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   {
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* Initialization of inputA pointer */
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     pIn1 = pSrcA;
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* Initialization of inputB pointer */
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     pIn2 = pSrcB;
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   }
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   else
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   {
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* Initialization of inputA pointer */
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     pIn1 = pSrcB;
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* Initialization of inputB pointer */
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     pIn2 = pSrcA;
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c **** 
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     /* srcBLen is always considered as shorter or equal to srcALen */
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     j = srcBLen;
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     srcBLen = srcALen;
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****     srcALen = j;
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q7.c ****   }
