 105:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** 
 106:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** /*
 107:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * Radix-4 FFT algorithm used is :
 108:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** *
 109:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * Input real and imaginary data:
 110:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(n) = xa + j * ya
 111:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(n+N/4 ) = xb + j * yb
 112:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(n+N/2 ) = xc + j * yc
 113:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(n+3N 4) = xd + j * yd
 114:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** *
 115:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** *
 116:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * Output real and imaginary data:
 117:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(4r) = xa'+ j * ya'
 118:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(4r+1) = xb'+ j * yb'
 119:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(4r+2) = xc'+ j * yc'
 120:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * x(4r+3) = xd'+ j * yd'
 121:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** *
 122:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** *
 123:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * Twiddle factors for radix-4 FFT:
 124:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * Wn = co1 + j * (- si1)
 125:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * W2n = co2 + j * (- si2)
 126:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * W3n = co3 + j * (- si3)
 127:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** 
 128:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * The real and imaginary output values for the radix-4 butterfly are
 129:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * xa' = xa + xb + xc + xd
 130:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * ya' = ya + yb + yc + yd
 131:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * xb' = (xa+yb-xc-yd)* co1 + (ya-xb-yc+xd)* (si1)
 132:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * yb' = (ya-xb-yc+xd)* co1 - (xa+yb-xc-yd)* (si1)
 133:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * xc' = (xa-xb+xc-xd)* co2 + (ya-yb+yc-yd)* (si2)
 134:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * yc' = (ya-yb+yc-yd)* co2 - (xa-xb+xc-xd)* (si2)
 135:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * xd' = (xa-yb-xc+yd)* co3 + (ya+xb-yc-xd)* (si3)
 136:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** * yd' = (ya+xb-yc-xd)* co3 - (xa-yb-xc+yd)* (si3)
 137:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** *
 138:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** */
 139:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** 
 140:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c **** /**
 141:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c ****  * @brief  Core function for the Q15 CFFT butterfly process.
 142:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c ****  * @param[in, out] *pSrc16          points to the in-place buffer of Q15 data type.
 143:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c ****  * @param[in]      fftLen           length of the FFT.
 144:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c ****  * @param[in]      *pCoef16         points to twiddle coefficient buffer.
 145:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q15.c ****  * @param[in]      twidCoefModifier twiddle coefficient modifier that supports different size FFTs 
