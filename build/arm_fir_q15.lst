  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   q31_t x0, x1, x2, x3, c0;                      /* Temporary variables to hold SIMD state and coef
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   q63_t acc0, acc1, acc2, acc3;                  /* Accumulators */
