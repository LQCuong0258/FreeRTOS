  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   /* S->pState points to state array which contains previous frame (numTaps - 1) samples */
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   /* pStateCurnt points to the location where the new input data should be written */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   pStateCurnt = &(S->pState[(numTaps - 1U)]);
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   /* Apply loop unrolling and compute 4 output values simultaneously.
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    * The variables acc0 ... acc3 hold output values that are being computed:
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    *
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    *    acc0 =  b[numTaps-1] * x[n-numTaps-1] + b[numTaps-2] * x[n-numTaps-2] + b[numTaps-3] * x[n-
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    *    acc1 =  b[numTaps-1] * x[n-numTaps] +   b[numTaps-2] * x[n-numTaps-1] + b[numTaps-3] * x[n-
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    *    acc2 =  b[numTaps-1] * x[n-numTaps+1] + b[numTaps-2] * x[n-numTaps] +   b[numTaps-3] * x[n-
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    *    acc3 =  b[numTaps-1] * x[n-numTaps+2] + b[numTaps-2] * x[n-numTaps+1] + b[numTaps-3] * x[n-
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    */
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   blkCnt = blockSize >> 2;
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   while (blkCnt > 0U)
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****   {
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Copy four new input samples into the state buffer.
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****      ** Use 32-bit SIMD to move the 16-bit data.  Only requires two copies. */
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     *__SIMD32(pStateCurnt)++ = *__SIMD32(pSrc)++;
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     *__SIMD32(pStateCurnt)++ = *__SIMD32(pSrc)++;
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Set all accumulators to zero */
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     acc0 = 0;
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     acc1 = 0;
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     acc2 = 0;
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     acc3 = 0;
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Initialize state pointer of type q15 */
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     px1 = pState;
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Initialize coeff pointer of type q31 */
 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     pb = pCoeffs;
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Read the first two samples from the state buffer:  x[n-N], x[n-N-1] */
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     x0 = _SIMD32_OFFSET(px1);
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Read the third and forth samples from the state buffer: x[n-N-1], x[n-N-2] */
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     x1 = _SIMD32_OFFSET(px1 + 1U);
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     px1 += 2U;
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     /* Loop over the number of taps.  Unroll by a factor of 4.
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****      ** Repeat until we've computed numTaps-4 coefficients. */
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     tapCnt = numTaps >> 2;
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     while (tapCnt > 0U)
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****     {
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****       /* Read the first two coefficients using SIMD:  b[N] and b[N-1] coefficients */
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****       c0 = *__SIMD32(pb)++;
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c **** 
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****       /* acc0 +=  b[N] * x[n-N] + b[N-1] * x[n-N-1] */
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q15.c ****       acc0 = __SMLALD(x0, c0, acc0);
