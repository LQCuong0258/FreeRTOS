  70:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_q31.c ****   q31_t * pSrc,
  71:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_q31.c ****   q31_t * pRef,
  72:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_q31.c ****   q31_t * pOut,
  73:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_q31.c ****   q31_t * pErr,
  74:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_q31.c ****   uint32_t blockSize)
