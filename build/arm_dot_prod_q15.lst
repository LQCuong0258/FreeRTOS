  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c **** 
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccKL31dg.s 			page 3


  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   while (blkCnt > 0U)
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   {
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     /* C = A[0]* B[0] + A[1]* B[1] + A[2]* B[2] + .....+ A[blockSize-1]* B[blockSize-1] */
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     /* Calculate dot product and then store the result in a temporary buffer. */
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     sum = __SMLALD(*__SIMD32(pSrcA)++, *__SIMD32(pSrcB)++, sum);
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     sum = __SMLALD(*__SIMD32(pSrcA)++, *__SIMD32(pSrcB)++, sum);
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c **** 
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     /* Decrement the loop counter */
  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     blkCnt--;
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   }
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c **** 
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****    ** No loop unrolling is used. */
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   blkCnt = blockSize % 0x4U;
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c **** 
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   while (blkCnt > 0U)
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   {
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     /* C = A[0]* B[0] + A[1]* B[1] + A[2]* B[2] + .....+ A[blockSize-1]* B[blockSize-1] */
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     /* Calculate dot product and then store the results in a temporary buffer. */
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     sum = __SMLALD(*pSrcA++, *pSrcB++, sum);
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c **** 
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     /* Decrement the loop counter */
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****     blkCnt--;
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q15.c ****   }
