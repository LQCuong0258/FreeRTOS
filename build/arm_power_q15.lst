  79:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  80:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  81:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   while (blkCnt > 0U)
  82:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   {
  83:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     /* C = A[0] * A[0] + A[1] * A[1] + A[2] * A[2] + ... + A[blockSize-1] * A[blockSize-1] */
  84:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     /* Compute Power and then store the result in a temporary variable, sum. */
  85:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     in32 = *__SIMD32(pSrc)++;
  86:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     sum = __SMLALD(in32, in32, sum);
  87:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     in32 = *__SIMD32(pSrc)++;
  88:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     sum = __SMLALD(in32, in32, sum);
  89:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c **** 
  90:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     /* Decrement the loop counter */
  91:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     blkCnt--;
  92:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   }
  93:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c **** 
  94:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  95:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****    ** No loop unrolling is used. */
  96:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   blkCnt = blockSize % 0x4U;
  97:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c **** 
  98:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   while (blkCnt > 0U)
  99:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****   {
 100:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     /* C = A[0] * A[0] + A[1] * A[1] + A[2] * A[2] + ... + A[blockSize-1] * A[blockSize-1] */
 101:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     /* Compute Power and then store the result in a temporary variable, sum. */
 102:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q15.c ****     in16 = *pSrc++;
