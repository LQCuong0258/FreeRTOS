  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     *pDst++ = (q15_t) __QADD16(*pSrcA++, *pSrcB++);
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c **** 
