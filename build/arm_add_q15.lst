  69:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c **** 
  70:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  71:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  72:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****   while (blkCnt > 0U)
  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****   {
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     /* C = A + B */
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     /* Add and then store the results in the destination buffer. */
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     inA1 = *__SIMD32(pSrcA)++;
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     inA2 = *__SIMD32(pSrcA)++;
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     inB1 = *__SIMD32(pSrcB)++;
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     inB2 = *__SIMD32(pSrcB)++;
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c **** 
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     *__SIMD32(pDst)++ = __QADD16(inA1, inB1);
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c ****     *__SIMD32(pDst)++ = __QADD16(inA2, inB2);
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_q15.c **** 
