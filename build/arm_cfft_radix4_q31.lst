 105:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** /*
 106:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Radix-4 FFT algorithm used is :
 107:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 108:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Input real and imaginary data:
 109:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n) = xa + j * ya
 110:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n+N/4 ) = xb + j * yb
 111:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n+N/2 ) = xc + j * yc
 112:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n+3N 4) = xd + j * yd
 113:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 114:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 115:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Output real and imaginary data:
 116:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r) = xa'+ j * ya'
 117:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r+1) = xb'+ j * yb'
 118:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r+2) = xc'+ j * yc'
 119:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r+3) = xd'+ j * yd'
 120:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 121:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 122:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Twiddle factors for radix-4 FFT:
 123:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Wn = co1 + j * (- si1)
 124:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * W2n = co2 + j * (- si2)
 125:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * W3n = co3 + j * (- si3)
 126:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 127:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *  Butterfly implementation:
 128:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xa' = xa + xb + xc + xd
 129:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * ya' = ya + yb + yc + yd
 130:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xb' = (xa+yb-xc-yd)* co1 + (ya-xb-yc+xd)* (si1)
 131:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * yb' = (ya-xb-yc+xd)* co1 - (xa+yb-xc-yd)* (si1)
 132:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xc' = (xa-xb+xc-xd)* co2 + (ya-yb+yc-yd)* (si2)
 133:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * yc' = (ya-yb+yc-yd)* co2 - (xa-xb+xc-xd)* (si2)
 134:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xd' = (xa-yb-xc+yd)* co3 + (ya+xb-yc-xd)* (si3)
 135:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * yd' = (ya+xb-yc-xd)* co3 - (xa-yb-xc+yd)* (si3)
 136:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 137:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** */
 138:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 139:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** /**
 140:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @brief  Core function for the Q31 CFFT butterfly process.
 141:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in, out] *pSrc            points to the in-place buffer of Q31 data type.
 142:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in]      fftLen           length of the FFT.
 143:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in]      *pCoef           points to twiddle coefficient buffer.
 144:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in]      twidCoefModifier twiddle coefficient modifier that supports different size FFTs 
 145:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @return none.
