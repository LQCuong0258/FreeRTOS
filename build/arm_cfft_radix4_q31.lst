 826:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 827:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   /* Initializations for the first stage */
 828:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   n2 = fftLen;
 829:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   n1 = n2;
 830:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   /* n2 = fftLen/4 */
 831:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   n2 >>= 2U;
 832:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   i0 = 0U;
 833:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   ia1 = 0U;
 834:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 835:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   j = n2;
 836:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 837:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   do
 838:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****   {
 839:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 840:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     /* input is in 1.31(q31) format and provide 4 guard bits for the input */
 841:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 842:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     /*  index calculation for the input as, */
 843:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     /*  pSrc[i0 + 0], pSrc[i0 + fftLen/4], pSrc[i0 + fftLen/2U], pSrc[i0 + 3fftLen/4] */
 844:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     i1 = i0 + n2;
 845:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     i2 = i1 + n2;
 846:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     i3 = i2 + n2;
 847:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 848:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     /*  Butterfly implementation */
 849:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     /* xa + xc */
 850:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     r1 = (pSrc[2U * i0] >> 4U) + (pSrc[2U * i2] >> 4U);
 851:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     /* xa - xc */
 852:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****     r2 = (pSrc[2U * i0] >> 4U) - (pSrc[2U * i2] >> 4U);
 853:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
