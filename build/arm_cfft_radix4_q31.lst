 754:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** /**
 755:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @brief  Core function for the Q31 CIFFT butterfly process.
 756:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in, out] *pSrc            points to the in-place buffer of Q31 data type.
 757:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in]      fftLen           length of the FFT.
 758:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in]      *pCoef           points to twiddle coefficient buffer.
 759:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @param[in]      twidCoefModifier twiddle coefficient modifier that supports different size FFTs 
 760:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  * @return none.
 761:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c ****  */
 762:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 763:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 764:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** /*
 765:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Radix-4 IFFT algorithm used is :
 766:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 767:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * CIFFT uses same twiddle coefficients as CFFT Function
 768:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *  x[k] = x[n] + (j)k * x[n + fftLen/4] + (-1)k * x[n+fftLen/2] + (-j)k * x[n+3*fftLen/4]
 769:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 770:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 771:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * IFFT is implemented with following changes in equations from FFT
 772:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 773:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Input real and imaginary data:
 774:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n) = xa + j * ya
 775:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n+N/4 ) = xb + j * yb
 776:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n+N/2 ) = xc + j * yc
 777:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(n+3N 4) = xd + j * yd
 778:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 779:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 780:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Output real and imaginary data:
 781:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r) = xa'+ j * ya'
 782:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r+1) = xb'+ j * yb'
 783:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r+2) = xc'+ j * yc'
 784:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * x(4r+3) = xd'+ j * yd'
 785:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 786:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 787:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Twiddle factors for radix-4 IFFT:
 788:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * Wn = co1 + j * (si1)
 789:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * W2n = co2 + j * (si2)
 790:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * W3n = co3 + j * (si3)
 791:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
 792:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * The real and imaginary output values for the radix-4 butterfly are
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\cc6tKCka.s 			page 35


 793:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xa' = xa + xb + xc + xd
 794:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * ya' = ya + yb + yc + yd
 795:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xb' = (xa-yb-xc+yd)* co1 - (ya+xb-yc-xd)* (si1)
 796:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * yb' = (ya+xb-yc-xd)* co1 + (xa-yb-xc+yd)* (si1)
 797:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xc' = (xa-xb+xc-xd)* co2 - (ya-yb+yc-yd)* (si2)
 798:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * yc' = (ya-yb+yc-yd)* co2 + (xa-xb+xc-xd)* (si2)
 799:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * xd' = (xa+yb-xc-yd)* co3 - (ya-xb-yc+xd)* (si3)
 800:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** * yd' = (ya-xb-yc+xd)* co3 + (xa+yb-xc-yd)* (si3)
 801:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** *
 802:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** */
 803:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_cfft_radix4_q31.c **** 
