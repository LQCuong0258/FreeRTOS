  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****     /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****      ** a second loop below computes the remaining 1 to 3 samples. */
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****     while (blkCnt > 0U)
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****     {
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       /* C = A << shiftBits */
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       /* Read 4 inputs */
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       in1 = *pSrc;
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       in2 = *(pSrc + 1);
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       in3 = *(pSrc + 2);
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       in4 = *(pSrc + 3);
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c **** 
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       /* Store the Shifted result in the destination buffer in single cycle by packing the outputs 
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       *__SIMD32(pDst)++ = __PACKq7(__SSAT((in1 << shiftBits), 8),
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****                                    __SSAT((in2 << shiftBits), 8),
 100:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****                                    __SSAT((in3 << shiftBits), 8),
 101:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****                                    __SSAT((in4 << shiftBits), 8));
 102:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       /* Update source pointer to process next sampels */
 103:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       pSrc += 4U;
 104:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c **** 
 105:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       /* Decrement the loop counter */
 106:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****       blkCnt--;
 107:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****     }
 108:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c **** 
 109:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****     /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
 110:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****      ** No loop unrolling is used. */
 111:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c ****     blkCnt = blockSize % 0x4U;
 112:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_shift_q7.c **** 
