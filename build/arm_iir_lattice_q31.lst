  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****   {
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* Read Sample from input buffer */
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* fN(n) = x(n) */
  86:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     fcurr = *pSrc++;
  87:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c **** 
  88:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* Initialize state read pointer */
  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     px1 = pState;
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* Initialize state write pointer */
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     px2 = pState;
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* Set accumulator to zero */
