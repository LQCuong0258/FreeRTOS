  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c **** 
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c **** 
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* Process sample for first tap */
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     gcurr = *px1++;
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     /* fN-1(n) = fN(n) - kN * gN-1(n-1) */
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_q31.c ****     fnext = __QSUB(fcurr, (q31_t) (((q63_t) gcurr * (*pk)) >> 31));
