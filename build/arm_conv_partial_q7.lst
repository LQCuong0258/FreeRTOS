  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****   {
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* The algorithm implementation is based on the lengths of the inputs. */
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* srcB is always made to slide across srcA. */
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* So srcBLen is always considered as shorter or equal to srcALen */
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     if (srcALen >= srcBLen)
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     {
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       /* Initialization of inputA pointer */
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       pIn1 = pSrcA;
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       /* Initialization of inputB pointer */
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       pIn2 = pSrcB;
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     }
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     else
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     {
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       /* Initialization of inputA pointer */
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       pIn1 = pSrcB;
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       /* Initialization of inputB pointer */
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       pIn2 = pSrcA;
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       /* srcBLen is always considered as shorter or equal to srcALen */
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       j = srcBLen;
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       srcBLen = srcALen;
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       srcALen = j;
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     }
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* Conditions to check which loopCounter holds
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccKXXlkO.s 			page 4


 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * the first and last indices of the output samples to be calculated. */
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     check = firstIndex + numPoints;
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     blockSize3 = ((int32_t)check > (int32_t)srcALen) ? (int32_t)check - (int32_t)srcALen : 0;
 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     blockSize3 = ((int32_t)firstIndex > (int32_t)srcALen - 1) ? blockSize3 - (int32_t)firstIndex + 
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     blockSize1 = (((int32_t) srcBLen - 1) - (int32_t) firstIndex);
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     blockSize1 = (blockSize1 > 0) ? ((check > (srcBLen - 1U)) ? blockSize1 :
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****                                      (int32_t) numPoints) : 0;
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     blockSize2 = (int32_t) check - ((blockSize3 + blockSize1) +
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****                                     (int32_t) firstIndex);
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     blockSize2 = (blockSize2 > 0) ? blockSize2 : 0;
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* conv(x,y) at n = x[n] * y[0] + x[n-1] * y[1] + x[n-2] * y[2] + ...+ x[n-N+1] * y[N -1] */
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* The function is internally
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * divided into three stages according to the number of multiplications that has to be
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * taken place between inputA samples and inputB samples. In the first stage of the
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * algorithm, the multiplications increase by one for every iteration.
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * In the second stage of the algorithm, srcBLen number of multiplications are done.
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * In the third stage of the algorithm, the multiplications decrease by one
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * for every iteration. */
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* Set the output pointer to point to the firstIndex
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * of the output sample to be calculated. */
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     pOut = pDst + firstIndex;
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* --------------------------
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * Initializations of stage1
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * -------------------------*/
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* sum = x[0] * y[0]
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * sum = x[0] * y[1] + x[1] * y[0]
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * ....
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * sum = x[0] * y[srcBlen - 1] + x[1] * y[srcBlen - 2] +...+ x[srcBLen - 1] * y[0]
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      */
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* In this stage the MAC operations are increased by 1 for every iteration.
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****        The count variable holds the number of MAC operations performed.
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****        Since the partial convolution starts from from firstIndex
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****        Number of Macs to be performed is firstIndex + 1 */
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     count = 1U + firstIndex;
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* Working pointer of inputA */
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     px = pIn1;
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* Working pointer of inputB */
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     pSrc2 = pIn2 + firstIndex;
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     py = pSrc2;
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* ------------------------
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * Stage1 process
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****      * ----------------------*/
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c **** 
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     /* The first stage starts here */
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     while (blockSize1 > 0)
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****     {
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       /* Accumulator is made zero for every iteration */
 176:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q7.c ****       sum = 0;
