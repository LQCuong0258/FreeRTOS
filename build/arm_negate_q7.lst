  70:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c **** 
  71:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  72:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****   while (blkCnt > 0U)
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****   {
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****     /* C = -A */
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****     /* Read four inputs */
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****     input = *__SIMD32(pSrc)++;
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c **** 
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****     /* Store the Negated results in the destination buffer in a single cycle by packing the results
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q7.c ****     *__SIMD32(pDst)++ = __QSUB8(zero, input);
