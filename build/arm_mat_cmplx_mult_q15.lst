 125:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_cmplx_mult_q15.c ****       /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
 126:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_cmplx_mult_q15.c ****        ** a second loop below computes the remaining 1 to 3 samples. */
 127:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_cmplx_mult_q15.c ****       while (col > 0U)
 128:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_cmplx_mult_q15.c ****       {
