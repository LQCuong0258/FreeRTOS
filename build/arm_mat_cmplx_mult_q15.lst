 136:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_cmplx_mult_q15.c ****         /* Update the pointer px to point to the next row of the transposed matrix */
 137:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_cmplx_mult_q15.c ****         px += numRowsB * 2;
