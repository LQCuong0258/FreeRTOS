  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c **** 
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* srcB is always made to slide across srcA. */
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* and the destination pointer modifier, inc is set to -1 */
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* If srcALen > srcBLen, zero pad has to be done to srcB to make the two inputs of same length */
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* But to improve the performance,
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****    * we include zeroes in the output instead of zero padding either of the the inputs*/
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* If srcALen > srcBLen,
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****    * (srcALen - srcBLen) zeroes has to included in the starting of the output buffer */
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****   /* If srcALen < srcBLen,
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****    * (srcALen - srcBLen) zeroes has to included in the ending of the output buffer */
