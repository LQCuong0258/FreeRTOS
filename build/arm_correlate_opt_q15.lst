 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****     /* CORR(x, y) = Reverse order(CORR(y, x)) */
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_opt_q15.c ****     /* Hence set the destination pointer to point to the last output sample */
