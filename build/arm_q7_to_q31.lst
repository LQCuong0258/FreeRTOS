  93:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (__ROR(in, 24)) & 0xFF000000;
  94:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (__ROR(in, 16)) & 0xFF000000;
  95:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (__ROR(in, 8)) & 0xFF000000;
  96:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  97:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** #endif //              #ifndef ARM_MATH_BIG_ENDIAN
  98:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  99:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     /* Decrement the loop counter */
 100:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     blkCnt--;
 101:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   }
 102:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
 103:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
 104:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****    ** No loop unrolling is used. */
 105:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   blkCnt = blockSize % 0x4U;
 106:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
 107:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** #else
