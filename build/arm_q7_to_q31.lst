  70:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
  71:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  72:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   /*loop Unrolling */
  73:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   blkCnt = blockSize >> 2U;
  74:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  75:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  76:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  77:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   while (blkCnt > 0U)
  78:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****   {
  79:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     /* C = (q31_t) A << 24 */
  80:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     /* convert from q7 to q31 and then store the results in the destination buffer */
  81:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     in = *__SIMD32(pIn)++;
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\cc419YoH.s 			page 3


  82:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  83:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** #ifndef ARM_MATH_BIG_ENDIAN
  84:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  85:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (__ROR(in, 8)) & 0xFF000000;
  86:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (__ROR(in, 16)) & 0xFF000000;
  87:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (__ROR(in, 24)) & 0xFF000000;
  88:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c ****     *pDst++ = (in & 0xFF000000);
  89:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
  90:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** #else
  91:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q31.c **** 
