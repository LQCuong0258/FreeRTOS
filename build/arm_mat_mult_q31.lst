 156:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 157:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           sum += (q63_t) a2 *b2;
 158:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           sum += (q63_t) a3 *b3;
 159:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 160:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           /* Decrement the loop counter */
 161:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           colCnt--;
 162:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         }
 163:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 164:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         /* If the columns of pSrcA is not a multiple of 4, compute any remaining output samples her
 165:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****          ** No loop unrolling is used. */
 166:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         colCnt = numColsA % 0x4U;
 167:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 168:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         while (colCnt > 0U)
 169:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         {
