  99:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****   else
 100:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** #endif /*    #ifdef ARM_MATH_MATRIX_CHECK    */
 101:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 102:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****   {
 103:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****     /* The following loop performs the dot-product of each row in pSrcA with each column in pSrcB *
 104:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****     /* row loop */
 105:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****     do
 106:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****     {
 107:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       /* Output pointer is set to starting address of the row being processed */
 108:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       px = pOut + i;
 109:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 110:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       /* For every row wise process, the column loop counter is to be initiated */
 111:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       col = numColsB;
 112:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 113:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       /* For every row wise process, the pIn2 pointer is set
 114:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****        ** to the starting address of the pSrcB data */
 115:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       pIn2 = pSrcB->pData;
 116:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 117:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       j = 0U;
 118:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 119:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       /* column loop */
 120:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       do
 121:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****       {
 122:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         /* Set the variable sum, that acts as accumulator, to zero */
 123:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         sum = 0;
 124:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 125:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         /* Initiate the pointer pIn1 to point to the starting address of pInA */
 126:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         pIn1 = pInA;
 127:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 128:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         /* Apply loop unrolling and compute 4 MACs simultaneously. */
 129:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         colCnt = numColsA >> 2;
 130:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 131:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 132:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         /* matrix multiplication */
 133:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         while (colCnt > 0U)
 134:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****         {
 135:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           /* c(m,n) = a(1,1)*b(1,1) + a(1,2) * b(2,1) + .... + a(m,p)*b(p,n) */
 136:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           /* Perform the multiply-accumulates */
 137:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           b0 = *pIn2;
 138:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           pIn2 += numColsB;
 139:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 140:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           a0 = *pIn1++;
 141:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           a1 = *pIn1++;
 142:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 143:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           b1 = *pIn2;
 144:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           pIn2 += numColsB;
 145:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           b2 = *pIn2;
 146:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           pIn2 += numColsB;
 147:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 148:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           sum += (q63_t) a0 *b0;
 149:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           sum += (q63_t) a1 *b1;
 150:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 151:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           a2 = *pIn1++;
 152:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           a3 = *pIn1++;
 153:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c **** 
 154:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           b3 = *pIn2;
 155:Drivers/CMSIS/DSP/Source/MatrixFunctions/arm_mat_mult_q31.c ****           pIn2 += numColsB;
