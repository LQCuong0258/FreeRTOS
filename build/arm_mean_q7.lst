  84:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_mean_q7.c ****     sum += ((in << 16U) >> 24U);
  85:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_mean_q7.c ****     sum += ((in <<  8U) >> 24U);
