  61:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  62:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** #if defined (ARM_MATH_DSP)
  63:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  64:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** /* Run the below code for Cortex-M4 and Cortex-M3 */
  65:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  66:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   /*loop Unrolling */
  67:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   blkCnt = blockSize >> 2U;
  68:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  69:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  70:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  71:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   while (blkCnt > 0U)
  72:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   {
  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     /* C = A - B */
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     /* Subtract and then store the results in the destination buffer 4 samples at a time. */
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     *__SIMD32(pDst)++ = __QSUB8(*__SIMD32(pSrcA)++, *__SIMD32(pSrcB)++);
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     /* Decrement the loop counter */
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     blkCnt--;
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   }
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****    ** No loop unrolling is used. */
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   blkCnt = blockSize % 0x4U;
