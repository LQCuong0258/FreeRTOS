  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   while (blkCnt > 0U)
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   {
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     /* C = A - B */
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     /* Subtract and then store the result in the destination buffer. */
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     *pDst++ = __SSAT(*pSrcA++ - *pSrcB++, 8);
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** 
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     /* Decrement the loop counter */
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****     blkCnt--;
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   }
