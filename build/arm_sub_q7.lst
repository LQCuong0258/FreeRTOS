  57:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   q7_t * pDst,
  58:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c ****   uint32_t blockSize)
  59:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_sub_q7.c **** {
