 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****   /* conv(x,y) at n = x[n] * y[0] + x[n-1] * y[1] + x[n-2] * y[2] + ...+ x[n-N+1] * y[N -1] */
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****   /* The function is internally
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****    * divided into three stages according to the number of multiplications that has to be
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****    * taken place between inputA samples and inputB samples. In the first stage of the
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****    * algorithm, the multiplications increase by one for every iteration.
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****    * In the second stage of the algorithm, srcBLen number of multiplications are done.
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****    * In the third stage of the algorithm, the multiplications decrease by one
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****    * for every iteration. */
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c **** 
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****   /* The algorithm is implemented in three stages.
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****      The loop counters of each stage is initiated here. */
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****   blockSize1 = srcBLen - 1U;
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****   blockSize2 = srcALen - (srcBLen - 1U);
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c ****   blockSize3 = blockSize1;
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_f32.c **** 
