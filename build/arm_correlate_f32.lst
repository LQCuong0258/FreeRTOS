 265:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****       /* x[0] * y[srcBLen - 1] */
 266:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****       sum += *px++ * *py++;
 267:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 268:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****       /* Decrement the loop counter */
 269:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****       k--;
 270:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     }
 271:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 272:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Store the result in the accumulator in the destination buffer. */
 273:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     *pOut = sum;
