 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* srcB is always made to slide across srcA. */
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* and the destination pointer modifier, inc is set to -1 */
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* If srcALen > srcBLen, zero pad has to be done to srcB to make the two inputs of same length */
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* But to improve the performance,
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    * we assume zeroes in the output instead of zero padding either of the the inputs*/
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* If srcALen > srcBLen,
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    * (srcALen - srcBLen) zeroes has to included in the starting of the output buffer */
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* If srcALen < srcBLen,
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    * (srcALen - srcBLen) zeroes has to included in the ending of the output buffer */
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   if (srcALen >= srcBLen)
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   {
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Initialization of inputA pointer */
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     pIn1 = pSrcA;
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Initialization of inputB pointer */
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     pIn2 = pSrcB;
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Number of output samples is calculated */
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     outBlockSize = (2U * srcALen) - 1U;
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* When srcALen > srcBLen, zero padding has to be done to srcB
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****      * to make their lengths equal.
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****      * Instead, (outBlockSize - (srcALen + srcBLen - 1))
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****      * number of output samples are made zero */
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     j = outBlockSize - (srcALen + (srcBLen - 1U));
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Updating the pointer position to non zero value */
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     pOut += j;
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //while (j > 0U)
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //{
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //  /* Zero is stored in the destination buffer */
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //  *pOut++ = 0.0f;
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //  /* Decrement the loop counter */
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //  j--;
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     //}
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   }
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   else
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   {
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Initialization of inputA pointer */
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     pIn1 = pSrcB;
 176:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
