 210:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 211:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* sum = x[0] * y[srcBlen - 1]
 212:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    * sum = x[0] * y[srcBlen-2] + x[1] * y[srcBlen - 1]
 213:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    * ....
 214:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    * sum = x[0] * y[0] + x[1] * y[1] +...+ x[srcBLen - 1] * y[srcBLen - 1]
 215:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****    */
 216:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 217:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   /* In this stage the MAC operations are increased by 1 for every iteration.
 218:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****      The count variable holds the number of MAC operations performed */
 219:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****   count = 1U;
