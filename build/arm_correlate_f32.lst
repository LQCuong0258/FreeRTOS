 280:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 281:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Increment the MAC count */
 282:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     count++;
 283:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c **** 
 284:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     /* Decrement the loop counter */
 285:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_f32.c ****     blockSize1--;
