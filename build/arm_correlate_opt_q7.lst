 645:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 646:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* calculation of index for initial approximated Val */
 647:Drivers/CMSIS/DSP/Include/arm_math.h ****     index = (uint32_t)(in >>  8);
 648:Drivers/CMSIS/DSP/Include/arm_math.h ****     index = (index & INDEX_MASK);
 649:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 650:Drivers/CMSIS/DSP/Include/arm_math.h ****     /*      1.15 with exp 1  */
 651:Drivers/CMSIS/DSP/Include/arm_math.h ****     out = pRecipTable[index];
 652:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 653:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* calculation of reciprocal value */
 654:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* running approximation for two iterations */
 655:Drivers/CMSIS/DSP/Include/arm_math.h ****     for (i = 0U; i < 2U; i++)
 656:Drivers/CMSIS/DSP/Include/arm_math.h ****     {
 657:Drivers/CMSIS/DSP/Include/arm_math.h ****       tempVal = (uint32_t) (((q31_t) in * out) >> 15);
 658:Drivers/CMSIS/DSP/Include/arm_math.h ****       tempVal = 0x7FFFu - tempVal;
 659:Drivers/CMSIS/DSP/Include/arm_math.h ****       /*      1.15 with exp 1 */
 660:Drivers/CMSIS/DSP/Include/arm_math.h ****       out = (q15_t) (((q31_t) out * tempVal) >> 14);
 661:Drivers/CMSIS/DSP/Include/arm_math.h ****       /* out = clip_q31_to_q15(((q31_t) out * tempVal) >> 14); */
 662:Drivers/CMSIS/DSP/Include/arm_math.h ****     }
 663:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 664:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* write output */
 665:Drivers/CMSIS/DSP/Include/arm_math.h ****     *dst = out;
 666:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 667:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* return num of signbits of out = 1/in value */
 668:Drivers/CMSIS/DSP/Include/arm_math.h ****     return (signBits + 1);
 669:Drivers/CMSIS/DSP/Include/arm_math.h ****   }
