  75:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
  76:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
  77:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t *pIn1;                                    /* inputA pointer               */
  78:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t *pIn2;                                    /* inputB pointer               */
  79:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t *pOut = pDst;                             /* output pointer               */
  80:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t *px;                                      /* Intermediate inputA pointer  */
  81:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t *py;                                      /* Intermediate inputB pointer  */
  82:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t *pSrc1;                                   /* Intermediate pointers        */
  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q31_t sum, acc0, acc1, acc2, acc3;             /* Accumulators                  */
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q31_t input1, input2;                          /* temporary variables */
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q15_t in1, in2;                                /* temporary variables */
  86:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   q7_t x0, x1, x2, x3, c0, c1;                   /* temporary variables for holding input and coeff
  87:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   uint32_t j, k = 0U, count, blkCnt, outBlockSize, blockSize1, blockSize2, blockSize3;  /* loop cou
  88:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   int32_t inc = 1;
  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* srcB is always made to slide across srcA. */
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* and the destination pointer modifier, inc is set to -1 */
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* If srcALen > srcBLen, zero pad has to be done to srcB to make the two inputs of same length */
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* But to improve the performance,
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * we include zeroes in the output instead of zero padding either of the the inputs*/
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* If srcALen > srcBLen,
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * (srcALen - srcBLen) zeroes has to included in the starting of the output buffer */
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* If srcALen < srcBLen,
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * (srcALen - srcBLen) zeroes has to included in the ending of the output buffer */
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   if (srcALen >= srcBLen)
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   {
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Initialization of inputA pointer */
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     pIn1 = (pSrcA);
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Initialization of inputB pointer */
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     pIn2 = (pSrcB);
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Number of output samples is calculated */
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     outBlockSize = (2U * srcALen) - 1U;
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* When srcALen > srcBLen, zero padding is done to srcB
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****      * to make their lengths equal.
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****      * Instead, (outBlockSize - (srcALen + srcBLen - 1))
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****      * number of output samples are made zero */
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     j = outBlockSize - (srcALen + (srcBLen - 1U));
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Updating the pointer position to non zero value */
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     pOut += j;
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccrh5sB2.s 			page 4


 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   }
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   else
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   {
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Initialization of inputA pointer */
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     pIn1 = (pSrcB);
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Initialization of inputB pointer */
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     pIn2 = (pSrcA);
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* srcBLen is always considered as shorter or equal to srcALen */
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     j = srcBLen;
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     srcBLen = srcALen;
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     srcALen = j;
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* CORR(x, y) = Reverse order(CORR(y, x)) */
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Hence set the destination pointer to point to the last output sample */
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     pOut = pDst + ((srcALen + srcBLen) - 2U);
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     /* Destination address modifier is set to -1 */
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****     inc = -1;
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   }
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* The function is internally
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * divided into three parts according to the number of multiplications that has to be
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * taken place between inputA samples and inputB samples. In the first part of the
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * algorithm, the multiplications increase by one for every iteration.
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * In the second part of the algorithm, srcBLen number of multiplications are done.
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * In the third part of the algorithm, the multiplications decrease by one
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * for every iteration.*/
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* The algorithm is implemented in three stages.
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * The loop counters of each stage is initiated here. */
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   blockSize1 = srcBLen - 1U;
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   blockSize2 = srcALen - (srcBLen - 1U);
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   blockSize3 = blockSize1;
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* --------------------------
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * Initializations of stage1
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * -------------------------*/
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* sum = x[0] * y[srcBlen - 1]
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * sum = x[0] * y[srcBlen - 2] + x[1] * y[srcBlen - 1]
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * ....
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    * sum = x[0] * y[0] + x[1] * y[1] +...+ x[srcBLen - 1] * y[srcBLen - 1]
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****    */
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* In this stage the MAC operations are increased by 1 for every iteration.
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****      The count variable holds the number of MAC operations performed */
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   count = 1U;
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* Working pointer of inputA */
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   px = pIn1;
 176:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c **** 
 177:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   /* Working pointer of inputB */
 178:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q7.c ****   pSrc1 = pIn2 + (srcBLen - 1U);
