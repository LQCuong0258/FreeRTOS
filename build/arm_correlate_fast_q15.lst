 658:Drivers/CMSIS/DSP/Include/arm_math.h ****       tempVal = 0x7FFFu - tempVal;
 659:Drivers/CMSIS/DSP/Include/arm_math.h ****       /*      1.15 with exp 1 */
 660:Drivers/CMSIS/DSP/Include/arm_math.h ****       out = (q15_t) (((q31_t) out * tempVal) >> 14);
 661:Drivers/CMSIS/DSP/Include/arm_math.h ****       /* out = clip_q31_to_q15(((q31_t) out * tempVal) >> 14); */
 662:Drivers/CMSIS/DSP/Include/arm_math.h ****     }
 663:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 664:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* write output */
 665:Drivers/CMSIS/DSP/Include/arm_math.h ****     *dst = out;
 666:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 667:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* return num of signbits of out = 1/in value */
