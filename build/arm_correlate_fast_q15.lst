 631:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c **** 
 632:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
 633:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* srcB is always made to slide across srcA. */
 634:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
 635:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccj3X8ei.s 			page 60


 636:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
 637:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* and the destination pointer modifier, inc is set to -1 */
 638:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* If srcALen > srcBLen, zero pad has to be done to srcB to make the two inputs of same length */
 639:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* But to improve the performance,
 640:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****    * we include zeroes in the output instead of zero padding either of the the inputs*/
 641:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* If srcALen > srcBLen,
 642:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****    * (srcALen - srcBLen) zeroes has to included in the starting of the output buffer */
 643:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   /* If srcALen < srcBLen,
 644:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****    * (srcALen - srcBLen) zeroes has to included in the ending of the output buffer */
 645:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_fast_q15.c ****   if (srcALen >= srcBLen)
