  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****   {
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* The algorithm implementation is based on the lengths of the inputs. */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* srcB is always made to slide across srcA. */
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* So srcBLen is always considered as shorter or equal to srcALen */
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     if (srcALen >= srcBLen)
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     {
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* Initialization of inputA pointer */
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       pIn1 = pSrcA;
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* Initialization of inputB pointer */
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       pIn2 = pSrcB;
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     }
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     else
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     {
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* Initialization of inputA pointer */
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       pIn1 = pSrcB;
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* Initialization of inputB pointer */
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       pIn2 = pSrcA;
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* srcBLen is always considered as shorter or equal to srcALen */
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       j = srcBLen;
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       srcBLen = srcALen;
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       srcALen = j;
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     }
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* Conditions to check which loopCounter holds
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * the first and last indices of the output samples to be calculated. */
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     check = firstIndex + numPoints;
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     blockSize3 = ((int32_t)check > (int32_t)srcALen) ? (int32_t)check - (int32_t)srcALen : 0;
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccK7ZUsL.s 			page 4


 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     blockSize3 = ((int32_t)firstIndex > (int32_t)srcALen - 1) ? blockSize3 - (int32_t)firstIndex + 
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     blockSize1 = (((int32_t) srcBLen - 1) - (int32_t) firstIndex);
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     blockSize1 = (blockSize1 > 0) ? ((check > (srcBLen - 1U)) ? blockSize1 :
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****                                      (int32_t) numPoints) : 0;
 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     blockSize2 = (int32_t) check - ((blockSize3 + blockSize1) +
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****                                     (int32_t) firstIndex);
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     blockSize2 = (blockSize2 > 0) ? blockSize2 : 0;
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* conv(x,y) at n = x[n] * y[0] + x[n-1] * y[1] + x[n-2] * y[2] + ...+ x[n-N+1] * y[N -1] */
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* The function is internally
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * divided into three stages according to the number of multiplications that has to be
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * taken place between inputA samples and inputB samples. In the first stage of the
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * algorithm, the multiplications increase by one for every iteration.
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * In the second stage of the algorithm, srcBLen number of multiplications are done.
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * In the third stage of the algorithm, the multiplications decrease by one
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * for every iteration. */
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* Set the output pointer to point to the firstIndex
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * of the output sample to be calculated. */
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     pOut = pDst + firstIndex;
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* --------------------------
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * Initializations of stage1
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * -------------------------*/
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* sum = x[0] * y[0]
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * sum = x[0] * y[1] + x[1] * y[0]
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * ....
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * sum = x[0] * y[srcBlen - 1] + x[1] * y[srcBlen - 2] +...+ x[srcBLen - 1] * y[0]
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      */
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* In this stage the MAC operations are increased by 1 for every iteration.
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****        The count variable holds the number of MAC operations performed.
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****        Since the partial convolution starts from firstIndex
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****        Number of Macs to be performed is firstIndex + 1 */
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     count = 1U + firstIndex;
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* Working pointer of inputA */
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     px = pIn1;
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* Working pointer of inputB */
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     pSrc2 = pIn2 + firstIndex;
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     py = pSrc2;
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* ------------------------
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * Stage1 process
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****      * ----------------------*/
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     /* The first loop starts here */
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     while (blockSize1 > 0)
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****     {
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* Accumulator is made zero for every iteration */
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       sum = 0;
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c **** 
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       /* Apply loop unrolling and compute 4 MACs simultaneously. */
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****       k = count >> 2U;
