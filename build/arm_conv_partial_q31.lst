  82:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****   /* Check for range of output samples to be calculated */
  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****   if ((firstIndex + numPoints) > ((srcALen + (srcBLen - 1U))))
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_partial_q31.c ****   {
