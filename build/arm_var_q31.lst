  90:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_var_q31.c ****   {
  91:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_var_q31.c ****     /* C = (A[0] * A[0] + A[1] * A[1] + ... + A[blockSize-1] * A[blockSize-1])  */
  92:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_var_q31.c ****     /* Compute Sum of squares of the input samples
