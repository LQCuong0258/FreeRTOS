  62:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** #if defined (ARM_MATH_DSP)
  63:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  64:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** /* Run the below code for Cortex-M4 and Cortex-M3 */
  65:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   q31_t offset_packed;                           /* Offset packed to 32 bit */
  66:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  67:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  68:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   /*loop Unrolling */
  69:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   blkCnt = blockSize >> 2U;
  70:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  71:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   /* Offset is packed to 32 bit in order to use SIMD32 for addition */
  72:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   offset_packed = __PACKq7(offset, offset, offset, offset);
  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   while (blkCnt > 0U)
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   {
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     /* C = A + offset */
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     /* Add offset and then store the results in the destination bufferfor 4 samples at a time. */
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     *__SIMD32(pDst)++ = __QADD8(*__SIMD32(pSrc)++, offset_packed);
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     /* Decrement the loop counter */
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccpqN0Hw.s 			page 3


  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     blkCnt--;
  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   }
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****    ** No loop unrolling is used. */
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   blkCnt = blockSize % 0x4U;
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   while (blkCnt > 0U)
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   {
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     /* C = A + offset */
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     /* Add offset and then store the result in the destination buffer. */
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     *pDst++ = (q7_t) __SSAT(*pSrc++ + offset, 8);
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     /* Decrement the loop counter */
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****     blkCnt--;
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c ****   }
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q7.c **** 
