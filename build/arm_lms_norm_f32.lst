 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****   /**
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @brief Processing function for floating-point normalized LMS filter.
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @param[in] *S points to an instance of the floating-point normalized LMS filter structure.
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @param[in] *pSrc points to the block of input data.
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @param[in] *pRef points to the block of reference data.
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @param[out] *pOut points to the block of output data.
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @param[out] *pErr points to the block of error data.
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @param[in] blockSize number of samples to process.
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    * @return none.
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****    */
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c **** 
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c **** void arm_lms_norm_f32(
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_norm_f32.c ****   arm_lms_norm_instance_f32 * S,
