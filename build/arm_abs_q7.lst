  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     in2 = (q31_t) * (pSrc + 1);
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccpTodEJ.s 			page 3


  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     in3 = (q31_t) * (pSrc + 2);
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* find absolute value */
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     out1 = (in1 > 0) ? in1 : (q31_t)__QSUB8(0, in1);
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* read input */
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     in4 = (q31_t) * (pSrc + 3);
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* find absolute value */
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     out2 = (in2 > 0) ? in2 : (q31_t)__QSUB8(0, in2);
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* store result to destination */
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     *pDst = (q7_t) out1;
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* find absolute value */
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     out3 = (in3 > 0) ? in3 : (q31_t)__QSUB8(0, in3);
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* find absolute value */
 100:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     out4 = (in4 > 0) ? in4 : (q31_t)__QSUB8(0, in4);
 101:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
 102:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* store result to destination */
 103:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     *(pDst + 1) = (q7_t) out2;
 104:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
 105:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* store result to destination */
 106:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     *(pDst + 2) = (q7_t) out3;
 107:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
 108:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* store result to destination */
 109:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     *(pDst + 3) = (q7_t) out4;
 110:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
 111:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* update pointers to process next samples */
 112:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     pSrc += 4U;
 113:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     pDst += 4U;
 114:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
