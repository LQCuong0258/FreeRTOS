  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c **** 
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****   while (blkCnt > 0U)
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****   {
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_q7.c ****     /* C = |A| */
