 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****   /* conv(x,y) at n = x[n] * y[0] + x[n-1] * y[1] + x[n-2] * y[2] + ...+ x[n-N+1] * y[N -1] */
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****   /* The function is internally
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****    * divided into three stages according to the number of multiplications that has to be
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****    * taken place between inputA samples and inputB samples. In the first stage of the
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****    * algorithm, the multiplications increase by one for every iteration.
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****    * In the second stage of the algorithm, srcBLen number of multiplications are done.
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****    * In the third stage of the algorithm, the multiplications decrease by one
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****    * for every iteration. */
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c **** 
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****   /* The algorithm is implemented in three stages.
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****      The loop counters of each stage is initiated here. */
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_fast_q31.c ****   blockSize1 = srcBLen - 1U;
