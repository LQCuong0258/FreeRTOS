  71:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
  72:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   /* loop Unrolling */
  73:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   blkCnt = blockSize >> 2U;
  74:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
  75:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  76:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  77:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   while (blkCnt > 0U)
  78:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   {
  79:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     /* C = (A[0] * A[0] + A[1] * A[1] + ... + A[blockSize-1] * A[blockSize-1]) */
  80:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     /* Compute sum of the squares and then store the results in a temporary variable, sum */
  81:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     in = *__SIMD32(pSrc)++;
  82:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     sum = __SMLALD(in, in, sum);
  83:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     in = *__SIMD32(pSrc)++;
  84:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     sum = __SMLALD(in, in, sum);
  85:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
  86:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     /* Decrement the loop counter */
  87:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     blkCnt--;
  88:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   }
  89:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
  90:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  91:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****    ** No loop unrolling is used. */
  92:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   blkCnt = blockSize % 0x4U;
  93:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
  94:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   while (blkCnt > 0U)
  95:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   {
  96:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     /* C = (A[0] * A[0] + A[1] * A[1] + ... + A[blockSize-1] * A[blockSize-1]) */
  97:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     /* Compute sum of the squares and then store the results in a temporary variable, sum */
  98:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     in1 = *pSrc++;
  99:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     sum = __SMLALD(in1, in1, sum);
 100:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
 101:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     /* Decrement the loop counter */
 102:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****     blkCnt--;
 103:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   }
 104:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c **** 
 105:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   /* Truncating and saturating the accumulator to 1.15 format */
 106:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   /* Store the result in the destination */
 107:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_rms_q15.c ****   arm_sqrt_q15(__SSAT((sum / (q63_t)blockSize) >> 15, 16), pResult);
