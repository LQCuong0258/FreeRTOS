 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q31.c **** 
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q31.c ****     /* Converting the result to 1.31 format */
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q31.c ****     /* Calc lower part of acc */
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q31.c ****     acc_l = acc & 0xffffffff;
