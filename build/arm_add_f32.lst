  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c **** 
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****   while (blkCnt > 0U)
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****   {
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* C = A + B */
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* Add and then store the results in the destination buffer. */
  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c **** 
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* read four inputs from sourceA and four inputs from sourceB */
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inA1 = *pSrcA;
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inB1 = *pSrcB;
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inA2 = *(pSrcA + 1);
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inB2 = *(pSrcB + 1);
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inA3 = *(pSrcA + 2);
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inB3 = *(pSrcB + 2);
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inA4 = *(pSrcA + 3);
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     inB4 = *(pSrcB + 3);
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c **** 
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* C = A + B */
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* add and store result to destination */
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     *pDst = inA1 + inB1;
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     *(pDst + 1) = inA2 + inB2;
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     *(pDst + 2) = inA3 + inB3;
 100:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     *(pDst + 3) = inA4 + inB4;
 101:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c **** 
 102:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* update pointers to process next samples */
 103:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     pSrcA += 4U;
 104:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     pSrcB += 4U;
 105:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     pDst += 4U;
 106:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c **** 
 107:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c **** 
 108:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     /* Decrement the loop counter */
 109:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****     blkCnt--;
 110:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_add_f32.c ****   }
