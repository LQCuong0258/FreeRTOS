  78:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c **** 
  79:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  80:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  81:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****   while (blkCnt > 0U)
  82:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****   {
  83:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     /* Reading two inputs of pSrc vector and packing */
  84:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     input1 = *__SIMD32(pSrc)++;
  85:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c **** 
  86:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     in1 = __SXTB16(__ROR(input1, 8));
  87:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     in2 = __SXTB16(input1);
  88:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c **** 
  89:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     /* C = A[0] * A[0] + A[1] * A[1] + A[2] * A[2] + ... + A[blockSize-1] * A[blockSize-1] */
  90:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     /* calculate power and accumulate to accumulator */
  91:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     sum = __SMLAD(in1, in1, sum);
  92:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     sum = __SMLAD(in2, in2, sum);
  93:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c **** 
  94:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     /* Decrement the loop counter */
  95:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****     blkCnt--;
  96:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****   }
  97:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c **** 
  98:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  99:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****    ** No loop unrolling is used. */
 100:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c ****   blkCnt = blockSize % 0x4U;
 101:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_power_q7.c **** 
