  60 0012 4FF08041 		mov	r1, #1073741824
  61              	.LVL3:
  62              		.loc 1 158 3 is_stmt 0 view .LVU10
  63 0016 1046     		mov	r0, r2
  64              	.LVL4:
  65              		.loc 1 158 3 view .LVU11
