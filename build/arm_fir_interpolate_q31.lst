 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c **** 
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****       /* Initialize state pointer */
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****       ptr1 = pState;
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c **** 
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****       /* Initialize coefficient pointer */
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****       ptr2 = pCoeffs + (S->L - j);
