  72:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   q63_t sum0;                                    /* Accumulators */
  73:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   q31_t x0, c0;                                  /* Temporary variables to hold state and coefficie
  74:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   uint32_t i, blkCnt, j;                         /* Loop counters */
  75:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   uint16_t phaseLen = S->phaseLength, tapCnt;    /* Length of each polyphase filter component */
  76:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c **** 
  77:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   uint32_t blkCntN2;
  78:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   q63_t acc0, acc1;
  79:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   q31_t x1;
  80:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c **** 
  81:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   /* S->pState buffer contains previous frame (phaseLen - 1) samples */
  82:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   /* pStateCurnt points to the location where the new input data should be written */
  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   pStateCurnt = S->pState + ((q31_t) phaseLen - 1);
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c **** 
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   /* Initialise  blkCnt */
  86:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   blkCnt = blockSize / 2;
  87:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****   blkCntN2 = blockSize - (2 * blkCnt);
  88:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c **** 
