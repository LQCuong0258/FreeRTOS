 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****        ** Repeat until we've computed numTaps-(4*S->L) coefficients. */
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q31.c ****       tapCnt = phaseLen >> 2U;
