  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_f32.c ****     in2 = *(pSrc + 1);
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_abs_f32.c ****     in3 = *(pSrc + 2);
