 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     {
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****       /* acc +=  b[N] * x[n-N] + b[N-1] * x[n-N-1] */
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****       /* Perform the multiply-accumulate */
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** #ifndef UNALIGNED_SUPPORT_DISABLE
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****       acc = __SMLALD(*__SIMD32(px)++, (*__SIMD32(pb)++), acc);
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****       acc = __SMLALD(*__SIMD32(px)++, (*__SIMD32(pb)++), acc);
 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** #else
