 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     }
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Calc lower part of acc */
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     acc_l = acc & 0xffffffff;
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Calc upper part of acc */
