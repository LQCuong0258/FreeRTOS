  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****   /* S->pState points to buffer which contains previous frame (numTaps - 1) samples */
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****   /* pStateCurnt points to the location where the new input data should be written */
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****   pStateCurnt = &(S->pState[(numTaps - 1U)]);
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
