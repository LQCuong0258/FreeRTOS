 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Apply shift for lower part of acc and upper part of acc */
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     acc = (uint32_t) acc_l >> lShift | acc_h << uShift;
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Converting the result to 1.15 format and saturate the output */
