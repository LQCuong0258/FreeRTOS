 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****   {
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Copy the new input sample into the state buffer */
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     *pStateCurnt++ = *pSrc++;
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Initialize state pointer */
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     px = pState;
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Initialize coefficient pointer */
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     pb = pCoeffs;
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Set the accumulator to zero */
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     acc = 0;
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* Loop unrolling.  Process 4 taps at a time. */
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     tapCnt = numTaps >> 2U;
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
