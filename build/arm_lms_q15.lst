 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     }
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c **** 
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     /* If the filter length is not a multiple of 4, compute the remaining filter taps */
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_lms_q15.c ****     tapCnt = numTaps % 0x4U;
