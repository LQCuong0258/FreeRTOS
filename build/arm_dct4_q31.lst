  99:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 100:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* pbuff initialized to input buffer */
 101:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   pbuff = pInlineBuffer;
  80              		.loc 1 101 3 is_stmt 1 view .LVU17
 102:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 103:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** #if defined (ARM_MATH_DSP)
 104:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 105:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
 106:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 107:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* Initializing the loop counter to N/2 >> 2 for loop unrolling by 4 */
 108:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   i = S->Nby2 >> 2U;
 109:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 110:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
 111:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
 112:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   do
 113:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   {
 114:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     /* Re-ordering of even and odd elements */
 115:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     /* pState[i] =  pInlineBuffer[2*i] */
 116:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS1++ = *pbuff++;
 117:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     /* pState[N-i-1] = pInlineBuffer[2*i+1] */
 118:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS2-- = *pbuff++;
 119:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 120:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS1++ = *pbuff++;
 121:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS2-- = *pbuff++;
 122:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 123:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS1++ = *pbuff++;
 124:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS2-- = *pbuff++;
 125:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 126:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS1++ = *pbuff++;
 127:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pS2-- = *pbuff++;
 128:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 129:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     /* Decrement the loop counter */
 130:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     i--;
 131:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   } while (i > 0U);
 132:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 133:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* pbuff initialized to input buffer */
 134:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   pbuff = pInlineBuffer;
 135:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 136:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* pS1 initialized to pState */
 137:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   pS1 = pState;
 138:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 139:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* Initializing the loop counter to N/4 instead of N for loop unrolling */
 140:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   i = S->N >> 2U;
 141:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 142:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* Processing with loop unrolling 4 times as N is always multiple of 4.
 143:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * Compute 4 outputs at a time */
 144:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   do
 145:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   {
 146:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     /* Writing the re-ordered output back to inplace input buffer */
 147:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pbuff++ = *pS1++;
 148:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pbuff++ = *pS1++;
 149:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pbuff++ = *pS1++;
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccBl1vnd.s 			page 5


 150:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     *pbuff++ = *pS1++;
 151:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 152:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     /* Decrement the loop counter */
 153:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****     i--;
 154:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   } while (i > 0U);
 155:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 156:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 157:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* ---------------------------------------------------------
 158:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *     Step2: Calculate RFFT for N-point input
 159:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * ---------------------------------------------------------- */
 160:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* pInlineBuffer is real input of length N , pState is the complex output of length 2N */
 161:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   arm_rfft_q31(S->pRfft, pInlineBuffer, pState);
 162:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
 163:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /*----------------------------------------------------------------------
