  64:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* DCT4 computation involves DCT2 (which is calculated using RFFT)
  65:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * along with some pre-processing and post-processing.
  66:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * Computational procedure is explained as follows:
  67:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * (a) Pre-processing involves multiplying input with cos factor,
  68:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *     r(n) = 2 * u(n) * cos(pi*(2*n+1)/(4*n))
  69:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *              where,
  70:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                 r(n) -- output of preprocessing
  71:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                 u(n) -- input to preprocessing(actual Source buffer)
  72:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * (b) Calculation of DCT2 using FFT is divided into three steps:
  73:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                  Step1: Re-ordering of even and odd elements of input.
  74:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                  Step2: Calculating FFT of the re-ordered input.
  75:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                  Step3: Taking the real part of the product of FFT output and weights.
  76:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * (c) Post-processing - DCT4 can be obtained from DCT2 output using the following equation:
  77:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                   Y4(k) = Y2(k) - Y4(k-1) and Y4(-1) = Y4(0)
  78:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                        where,
  79:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *                           Y4 -- DCT4 output,   Y2 -- DCT2 output
  80:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * (d) Multiplying the output with the normalizing factor sqrt(2/N).
  81:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    */
  82:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
  83:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****         /*-------- Pre-processing ------------*/
  84:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* Multiplying input with cos factor i.e. r(n) = 2 * x(n) * cos(pi*(2*n+1)/(4*n)) */
  85:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   arm_mult_q31(pInlineBuffer, cosFact, pInlineBuffer, S->N);
  53              		.loc 1 85 3 view .LVU8
  54 000a 0388     		ldrh	r3, [r0]
  55 000c C168     		ldr	r1, [r0, #12]
  56              	.LVL2:
  57              		.loc 1 85 3 is_stmt 0 view .LVU9
  58 000e 1046     		mov	r0, r2
  59              	.LVL3:
  60              		.loc 1 85 3 view .LVU10
  61 0010 FFF7FEFF 		bl	arm_mult_q31
  62              	.LVL4:
  86:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   arm_shift_q31(pInlineBuffer, 1, pInlineBuffer, S->N);
  63              		.loc 1 86 3 is_stmt 1 view .LVU11
  64 0014 2B88     		ldrh	r3, [r5]
  65 0016 2246     		mov	r2, r4
  66 0018 0121     		movs	r1, #1
  67 001a 2046     		mov	r0, r4
  68 001c FFF7FEFF 		bl	arm_shift_q31
  69              	.LVL5:
  87:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
  88:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* ----------------------------------------------------------------
  89:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    * Step1: Re-ordering of even and odd elements as
  90:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *             pState[i] =  pInlineBuffer[2*i] and
  91:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    *             pState[N-i-1] = pInlineBuffer[2*i+1] where i = 0 to N/2
  92:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****    ---------------------------------------------------------------------*/
  93:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
  94:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* pS1 initialized to pState */
  95:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   pS1 = pState;
  70              		.loc 1 95 3 view .LVU12
  96:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c **** 
  97:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   /* pS2 initialized to pState+N-1, so that it points to the end of the state buffer */
  98:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q31.c ****   pS2 = pState + (S->N - 1U);
  71              		.loc 1 98 3 view .LVU13
  72              		.loc 1 98 20 is_stmt 0 view .LVU14
  73 0020 2888     		ldrh	r0, [r5]
  74              		.loc 1 98 16 view .LVU15
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccBl1vnd.s 			page 4


  75 0022 00F18040 		add	r0, r0, #1073741824
  76 0026 0138     		subs	r0, r0, #1
