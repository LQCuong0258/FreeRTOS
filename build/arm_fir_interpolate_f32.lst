 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_f32.c ****   float32_t *pStateCurnt;                        /* Points to the current sample of the state */
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_f32.c ****   float32_t *ptr1, *ptr2;                        /* Temporary pointers for state and coefficient bu
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_f32.c ****   float32_t sum0;                                /* Accumulators */
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_f32.c ****   float32_t x0, c0;                              /* Temporary variables to hold state and coefficie
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_f32.c ****   uint32_t i, blkCnt, j;                         /* Loop counters */
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_f32.c ****   uint16_t phaseLen = S->phaseLength, tapCnt;    /* Length of each polyphase filter component */
