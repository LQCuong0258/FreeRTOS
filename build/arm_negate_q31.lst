  67:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****   blkCnt = blockSize >> 2U;
  68:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c **** 
  69:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  70:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  71:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****   while (blkCnt > 0U)
  72:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****   {
  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     /* C = -A */
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     /* Negate and then store the results in the destination buffer. */
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     in1 = *pSrc++;
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     in2 = *pSrc++;
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     in3 = *pSrc++;
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     in4 = *pSrc++;
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c **** 
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     *pDst++ = __QSUB(0, in1);
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_negate_q31.c ****     *pDst++ = __QSUB(0, in2);
