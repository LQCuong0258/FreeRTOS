  64:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** /* Run the below code for Cortex-M4 and Cortex-M3 */
  65:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   q31_t in1, in2, in3, in4;
  66:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  67:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  68:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   /*loop Unrolling */
  69:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   blkCnt = blockSize >> 2U;
  70:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  71:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  72:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  73:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   while (blkCnt > 0U)
  74:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   {
  75:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     /* C = A + offset */
  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     /* Add offset and then store the results in the destination buffer. */
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     in1 = *pSrc++;
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     in2 = *pSrc++;
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     in3 = *pSrc++;
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     in4 = *pSrc++;
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     *pDst++ = __QADD(in1, offset);
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     *pDst++ = __QADD(in2, offset);
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccp0wJvp.s 			page 3


  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     *pDst++ = __QADD(in3, offset);
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     *pDst++ = __QADD(in4, offset);
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     /* Decrement the loop counter */
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     blkCnt--;
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   }
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****    ** No loop unrolling is used. */
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   blkCnt = blockSize % 0x4U;
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   while (blkCnt > 0U)
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   {
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     /* C = A + offset */
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     /* Add offset and then store the result in the destination buffer. */
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     *pDst++ = __QADD(*pSrc++, offset);
 100:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
 101:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     /* Decrement the loop counter */
 102:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****     blkCnt--;
 103:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   }
 104:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** 
 105:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c **** #else
