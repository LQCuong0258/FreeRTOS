 109:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   /* Initialize blkCnt with number of samples */
 110:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_offset_q31.c ****   blkCnt = blockSize;
