 193:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* First part of the processing with loop unrolling.  Compute 4 MACs at a time.
 194:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****      ** a second loop below computes MACs for the remaining 1 to 3 samples. */
 195:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     while (k > 0U)
 196:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     {
