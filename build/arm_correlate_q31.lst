 217:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       /* x[0] * y[srcBLen - 1] */
 218:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       sum += (q63_t) * px++ * (*py++);
 219:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 220:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       /* Decrement the loop counter */
 221:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       k--;
 222:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     }
 223:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 224:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Store the result in the accumulator in the destination buffer. */
 225:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     *pOut = (q31_t) (sum >> 31);
