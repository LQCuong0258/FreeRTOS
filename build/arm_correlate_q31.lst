 210:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* If the count is not a multiple of 4, compute any remaining MACs here.
 211:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****      ** No loop unrolling is used. */
 212:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     k = count % 0x4U;
 213:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
