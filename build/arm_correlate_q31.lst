  73:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
  74:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** #if defined (ARM_MATH_DSP)
  75:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
  76:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
  77:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
  78:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t *pIn1;                                   /* inputA pointer               */
  79:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t *pIn2;                                   /* inputB pointer               */
  80:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t *pOut = pDst;                            /* output pointer               */
  81:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t *px;                                     /* Intermediate inputA pointer  */
  82:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t *py;                                     /* Intermediate inputB pointer  */
  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t *pSrc1;                                  /* Intermediate pointers        */
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q63_t sum, acc0, acc1, acc2;                   /* Accumulators                  */
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   q31_t x0, x1, x2, c0;                          /* temporary variables for holding input and coeff
  86:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   uint32_t j, k = 0U, count, blkCnt, outBlockSize, blockSize1, blockSize2, blockSize3;  /* loop cou
  87:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   int32_t inc = 1;                               /* Destination address modifier */
  88:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* srcB is always made to slide across srcA. */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* and the destination pointer modifier, inc is set to -1 */
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* If srcALen > srcBLen, zero pad has to be done to srcB to make the two inputs of same length */
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* But to improve the performance,
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * we include zeroes in the output instead of zero padding either of the the inputs*/
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* If srcALen > srcBLen,
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * (srcALen - srcBLen) zeroes has to included in the starting of the output buffer */
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* If srcALen < srcBLen,
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * (srcALen - srcBLen) zeroes has to included in the ending of the output buffer */
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   if (srcALen >= srcBLen)
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   {
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Initialization of inputA pointer */
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     pIn1 = (pSrcA);
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Initialization of inputB pointer */
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     pIn2 = (pSrcB);
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Number of output samples is calculated */
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     outBlockSize = (2U * srcALen) - 1U;
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* When srcALen > srcBLen, zero padding is done to srcB
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****      * to make their lengths equal.
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****      * Instead, (outBlockSize - (srcALen + srcBLen - 1))
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****      * number of output samples are made zero */
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     j = outBlockSize - (srcALen + (srcBLen - 1U));
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Updating the pointer position to non zero value */
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccTPywwY.s 			page 4


 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     pOut += j;
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   }
 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   else
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   {
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Initialization of inputA pointer */
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     pIn1 = (pSrcB);
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Initialization of inputB pointer */
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     pIn2 = (pSrcA);
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* srcBLen is always considered as shorter or equal to srcALen */
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     j = srcBLen;
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     srcBLen = srcALen;
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     srcALen = j;
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* CORR(x, y) = Reverse order(CORR(y, x)) */
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Hence set the destination pointer to point to the last output sample */
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     pOut = pDst + ((srcALen + srcBLen) - 2U);
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     /* Destination address modifier is set to -1 */
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****     inc = -1;
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   }
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* The function is internally
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * divided into three parts according to the number of multiplications that has to be
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * taken place between inputA samples and inputB samples. In the first part of the
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * algorithm, the multiplications increase by one for every iteration.
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * In the second part of the algorithm, srcBLen number of multiplications are done.
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * In the third part of the algorithm, the multiplications decrease by one
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * for every iteration.*/
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* The algorithm is implemented in three stages.
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * The loop counters of each stage is initiated here. */
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   blockSize1 = srcBLen - 1U;
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   blockSize2 = srcALen - (srcBLen - 1U);
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   blockSize3 = blockSize1;
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* --------------------------
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * Initializations of stage1
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * -------------------------*/
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* sum = x[0] * y[srcBlen - 1]
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * sum = x[0] * y[srcBlen - 2] + x[1] * y[srcBlen - 1]
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * ....
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    * sum = x[0] * y[0] + x[1] * y[1] +...+ x[srcBLen - 1] * y[srcBLen - 1]
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****    */
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* In this stage the MAC operations are increased by 1 for every iteration.
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****      The count variable holds the number of MAC operations performed */
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   count = 1U;
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* Working pointer of inputA */
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   px = pIn1;
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 176:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* Working pointer of inputB */
