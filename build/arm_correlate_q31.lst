 574:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c **** 
 575:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
 576:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* srcB is always made to slide across srcA. */
 577:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
 578:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
 579:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
 580:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* and a varaible, inv is set to 1 */
 581:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****   /* If lengths are not equal then zero pad has to be done to  make the two
