 198:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       sum += (q63_t) * px++ * (*py++);
 199:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       /* x[1] * y[srcBLen - 3] */
 200:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q31.c ****       sum += (q63_t) * px++ * (*py++);
