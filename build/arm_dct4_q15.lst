 153:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     i--;
 154:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   } while (i > 0U);
