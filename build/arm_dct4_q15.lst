 101:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 102:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 103:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** #if defined (ARM_MATH_DSP)
 104:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 105:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
 106:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 107:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   /* Initializing the loop counter to N/2 >> 2 for loop unrolling by 4 */
 108:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   i = (uint32_t) S->Nby2 >> 2U;
 109:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 110:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
 111:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
 112:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   do
 113:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   {
 114:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     /* Re-ordering of even and odd elements */
 115:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     /* pState[i] =  pInlineBuffer[2*i] */
 116:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS1++ = *pbuff++;
 117:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     /* pState[N-i-1] = pInlineBuffer[2*i+1] */
 118:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS2-- = *pbuff++;
 119:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 120:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS1++ = *pbuff++;
 121:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS2-- = *pbuff++;
 122:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 123:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS1++ = *pbuff++;
 124:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS2-- = *pbuff++;
 125:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 126:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS1++ = *pbuff++;
 127:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     *pS2-- = *pbuff++;
 128:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 129:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     /* Decrement the loop counter */
 130:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****     i--;
 131:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   } while (i > 0U);
 132:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c **** 
 133:Drivers/CMSIS/DSP/Source/TransformFunctions/arm_dct4_q15.c ****   /* pbuff initialized to input buffer */
