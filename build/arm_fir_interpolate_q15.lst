  77:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q15.c ****   q63_t acc0, acc1;
  78:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q15.c ****   q15_t x1;
  79:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q15.c **** 
  80:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q15.c ****   /* S->pState buffer contains previous frame (phaseLen - 1) samples */
  81:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_interpolate_q15.c ****   /* pStateCurnt points to the location where the new input data should be written */
