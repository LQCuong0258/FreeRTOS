  82:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   {
  83:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     /* C = (q15_t) A << 8 */
  84:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     /* convert from q7 to q15 and then store the results in the destination buffer */
  85:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in = *__SIMD32(pIn)++;
  86:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  87:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     /* rotatate in by 8 and extend two q7_t values to q15_t values */
  88:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in1 = __SXTB16(__ROR(in, 8));
  89:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  90:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     /* extend remainig two q7_t values to q15_t values */
  91:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in2 = __SXTB16(in);
  92:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  93:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in1 = in1 << 8U;
  94:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in2 = in2 << 8U;
  95:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  96:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in1 = in1 & 0xFF00FF00;
  97:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     in2 = in2 & 0xFF00FF00;
  98:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  99:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** #ifndef ARM_MATH_BIG_ENDIAN
 100:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 101:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     out2 = __PKHTB(in1, in2, 16);
 102:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     out1 = __PKHBT(in2, in1, 16);
 103:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 104:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** #else
 105:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 106:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     out1 = __PKHTB(in1, in2, 16);
 107:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     out2 = __PKHBT(in2, in1, 16);
 108:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 109:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** #endif
 110:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 111:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     *__SIMD32(pDst)++ = out1;
 112:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     *__SIMD32(pDst)++ = out2;
 113:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 114:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     /* Decrement the loop counter */
 115:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****     blkCnt--;
 116:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   }
 117:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 118:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
 119:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****    ** No loop unrolling is used. */
 120:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   blkCnt = blockSize % 0x4U;
 121:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 122:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** #else
 123:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 124:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   /* Run the below code for Cortex-M0 */
 125:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
 126:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   /* Loop over blockSize number of values */
 127:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   blkCnt = blockSize;
  35              		.loc 1 127 3 view .LVU3
 128:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
