  70:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   q31_t in;
  71:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   q31_t in1, in2;
  72:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   q31_t out1, out2;
  73:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  74:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
  75:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  76:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   /*loop Unrolling */
  77:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   blkCnt = blockSize >> 2U;
  78:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c **** 
  79:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  80:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  81:Drivers/CMSIS/DSP/Source/SupportFunctions/arm_q7_to_q15.c ****   while (blkCnt > 0U)
