 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c **** 
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****     /* Read the first two samples from the state buffer:
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****      *  x[n-numTaps], x[n-numTaps-1] */
 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****     x0 = *(px++);
