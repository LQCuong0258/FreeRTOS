 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****   while (blkCnt > 0U)
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_fir_q31.c ****   {
