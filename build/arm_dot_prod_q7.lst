  76:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   /*loop Unrolling */
  77:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   blkCnt = blockSize >> 2U;
  78:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
  79:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   /* First part of the processing with loop unrolling.  Compute 4 outputs at a time.
  80:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****    ** a second loop below computes the remaining 1 to 3 samples. */
  81:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   while (blkCnt > 0U)
  82:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   {
  83:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* read 4 samples at a time from sourceA */
  84:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     input1 = *__SIMD32(pSrcA)++;
  85:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* read 4 samples at a time from sourceB */
  86:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     input2 = *__SIMD32(pSrcB)++;
  87:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
  88:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* extract two q7_t samples to q15_t samples */
  89:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     inA1 = __SXTB16(__ROR(input1, 8));
  90:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* extract reminaing two samples */
  91:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     inA2 = __SXTB16(input1);
  92:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* extract two q7_t samples to q15_t samples */
  93:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     inB1 = __SXTB16(__ROR(input2, 8));
  94:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* extract reminaing two samples */
  95:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     inB2 = __SXTB16(input2);
  96:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
  97:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* multiply and accumulate two samples at a time */
  98:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     sum = __SMLAD(inA1, inB1, sum);
  99:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     sum = __SMLAD(inA2, inB2, sum);
 100:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
 101:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* Decrement the loop counter */
 102:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     blkCnt--;
 103:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   }
 104:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
 105:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   /* If the blockSize is not a multiple of 4, compute any remaining output samples here.
 106:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****    ** No loop unrolling is used. */
 107:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   blkCnt = blockSize % 0x4U;
 108:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
 109:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   while (blkCnt > 0U)
 110:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   {
 111:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* C = A[0]* B[0] + A[1]* B[1] + A[2]* B[2] + .....+ A[blockSize-1]* B[blockSize-1] */
 112:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* Dot product and then store the results in a temporary buffer. */
 113:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     sum = __SMLAD(*pSrcA++, *pSrcB++, sum);
 114:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
 115:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     /* Decrement the loop counter */
 116:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****     blkCnt--;
 117:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   }
 118:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
 119:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** #else
 120:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
 121:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c ****   /* Run the below code for Cortex-M0 */
 122:Drivers/CMSIS/DSP/Source/BasicMathFunctions/arm_dot_prod_q7.c **** 
