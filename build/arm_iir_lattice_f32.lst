 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****   /* initialise state pointer */
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****   pState = &S->pState[0];
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c **** 
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****   /* Sample processing */
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****   while (blkCnt > 0U)
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****   {
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Read Sample from input buffer */
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* fN(n) = x(n) */
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     fnext2 = *pSrc++;
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c **** 
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Initialize Ladder coeff pointer */
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     pv = &S->pvCoeffs[0];
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Initialize Reflection coeff pointer */
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     pk = &S->pkCoeffs[0];
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c **** 
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Initialize state read pointer */
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     px1 = pState;
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Initialize state write pointer */
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     px2 = pState;
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c **** 
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Set accumulator to zero */
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     acc = 0.0;
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c **** 
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     /* Loop unrolling.  Process 4 taps at a time. */
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     tapCnt = (numStages) >> 2;
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c **** 
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     while (tapCnt > 0U)
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_iir_lattice_f32.c ****     {
