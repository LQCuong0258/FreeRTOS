  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* srcB is always made to slide across srcA. */
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* and the destination pointer modifier, inc is set to -1 */
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* If srcALen > srcBLen, zero pad has to be done to srcB to make the two inputs of same length */
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* But to improve the performance,
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * we include zeroes in the output instead of zero padding either of the the inputs*/
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* If srcALen > srcBLen,
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * (srcALen - srcBLen) zeroes has to included in the starting of the output buffer */
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* If srcALen < srcBLen,
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * (srcALen - srcBLen) zeroes has to included in the ending of the output buffer */
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   if (srcALen >= srcBLen)
