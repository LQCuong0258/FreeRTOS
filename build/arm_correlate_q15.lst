 569:Drivers/CMSIS/DSP/Include/arm_math.h ****   /**
 570:Drivers/CMSIS/DSP/Include/arm_math.h ****    * @brief Function to Calculates 1/in (reciprocal) value of Q31 Data type.
 571:Drivers/CMSIS/DSP/Include/arm_math.h ****    */
 572:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 573:Drivers/CMSIS/DSP/Include/arm_math.h ****   CMSIS_INLINE __STATIC_INLINE uint32_t arm_recip_q31(
 574:Drivers/CMSIS/DSP/Include/arm_math.h ****   q31_t in,
 575:Drivers/CMSIS/DSP/Include/arm_math.h ****   q31_t * dst,
 576:Drivers/CMSIS/DSP/Include/arm_math.h ****   q31_t * pRecipTable)
 577:Drivers/CMSIS/DSP/Include/arm_math.h ****   {
 578:Drivers/CMSIS/DSP/Include/arm_math.h ****     q31_t out;
 579:Drivers/CMSIS/DSP/Include/arm_math.h ****     uint32_t tempVal;
 580:Drivers/CMSIS/DSP/Include/arm_math.h ****     uint32_t index, i;
 581:Drivers/CMSIS/DSP/Include/arm_math.h ****     uint32_t signBits;
 582:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 583:Drivers/CMSIS/DSP/Include/arm_math.h ****     if (in > 0)
 584:Drivers/CMSIS/DSP/Include/arm_math.h ****     {
 585:Drivers/CMSIS/DSP/Include/arm_math.h ****       signBits = ((uint32_t) (__CLZ( in) - 1));
 586:Drivers/CMSIS/DSP/Include/arm_math.h ****     }
 587:Drivers/CMSIS/DSP/Include/arm_math.h ****     else
 588:Drivers/CMSIS/DSP/Include/arm_math.h ****     {
 589:Drivers/CMSIS/DSP/Include/arm_math.h ****       signBits = ((uint32_t) (__CLZ(-in) - 1));
 590:Drivers/CMSIS/DSP/Include/arm_math.h ****     }
 591:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 592:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* Convert input sample to 1.31 format */
 593:Drivers/CMSIS/DSP/Include/arm_math.h ****     in = (in << signBits);
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccJUbmgO.s 			page 19


 594:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 595:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* calculation of index for initial approximated Val */
 596:Drivers/CMSIS/DSP/Include/arm_math.h ****     index = (uint32_t)(in >> 24);
 597:Drivers/CMSIS/DSP/Include/arm_math.h ****     index = (index & INDEX_MASK);
 598:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 599:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* 1.31 with exp 1 */
 600:Drivers/CMSIS/DSP/Include/arm_math.h ****     out = pRecipTable[index];
 601:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 602:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* calculation of reciprocal value */
 603:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* running approximation for two iterations */
 604:Drivers/CMSIS/DSP/Include/arm_math.h ****     for (i = 0U; i < 2U; i++)
 605:Drivers/CMSIS/DSP/Include/arm_math.h ****     {
 606:Drivers/CMSIS/DSP/Include/arm_math.h ****       tempVal = (uint32_t) (((q63_t) in * out) >> 31);
 607:Drivers/CMSIS/DSP/Include/arm_math.h ****       tempVal = 0x7FFFFFFFu - tempVal;
 608:Drivers/CMSIS/DSP/Include/arm_math.h ****       /*      1.31 with exp 1 */
 609:Drivers/CMSIS/DSP/Include/arm_math.h ****       /* out = (q31_t) (((q63_t) out * tempVal) >> 30); */
 610:Drivers/CMSIS/DSP/Include/arm_math.h ****       out = clip_q63_to_q31(((q63_t) out * tempVal) >> 30);
 611:Drivers/CMSIS/DSP/Include/arm_math.h ****     }
 612:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 613:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* write output */
 614:Drivers/CMSIS/DSP/Include/arm_math.h ****     *dst = out;
 615:Drivers/CMSIS/DSP/Include/arm_math.h **** 
 616:Drivers/CMSIS/DSP/Include/arm_math.h ****     /* return num of signbits of out = 1/in value */
 617:Drivers/CMSIS/DSP/Include/arm_math.h ****     return (signBits + 1U);
