 623:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   q15_t *pIn2 = pSrcB + (srcBLen - 1U);          /* inputB pointer               */
 624:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   q63_t sum;                                     /* Accumulators                  */
 625:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   uint32_t i = 0U, j;                            /* loop counters */
 626:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   uint32_t inv = 0U;                             /* Reverse order flag */
 627:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   uint32_t tot = 0U;                             /* Length */
 628:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 629:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
 630:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* srcB is always made to slide across srcA. */
 631:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
 632:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* But CORR(x, y) is reverse of CORR(y, x) */
 633:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* So, when srcBLen > srcALen, output pointer is made to point to the end of the output buffer */
 634:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* and a varaible, inv is set to 1 */
 635:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* If lengths are not equal then zero pad has to be done to  make the two
 636:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * inputs of same length. But to improve the performance, we include zeroes
 637:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * in the output instead of zero padding either of the the inputs*/
 638:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* If srcALen > srcBLen, (srcALen - srcBLen) zeroes has to included in the
 639:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * starting of the output buffer */
 640:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* If srcALen < srcBLen, (srcALen - srcBLen) zeroes has to included in the
 641:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * ending of the output buffer */
 642:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* Once the zero padding is done the remaining of the output is calcualted
 643:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****    * using convolution but with the shorter signal time shifted. */
 644:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 645:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* Calculate the length of the remaining sequence */
 646:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   tot = ((srcALen + srcBLen) - 2U);
 647:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 648:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   if (srcALen > srcBLen)
 649:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   {
 650:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Calculating the number of zeros to be padded to the output */
 651:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     j = srcALen - srcBLen;
 652:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 653:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Initialise the pointer after zero padding */
 654:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     pDst += j;
 655:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   }
 656:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 657:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   else if (srcALen < srcBLen)
 658:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   {
 659:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Initialization to inputB pointer */
 660:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     pIn1 = pSrcB;
 661:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 662:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Initialization to the end of inputA pointer */
 663:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     pIn2 = pSrcA + (srcALen - 1U);
 664:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 665:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Initialisation of the pointer after zero padding */
 666:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     pDst = pDst + tot;
 667:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 668:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Swapping the lengths */
 669:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     j = srcALen;
 670:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     srcALen = srcBLen;
 671:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     srcBLen = j;
 672:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 673:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Setting the reverse flag */
 674:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     inv = 1;
 675:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 676:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   }
 677:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\ccJUbmgO.s 			page 69


 678:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   /* Loop to calculate convolution for output length number of times */
 679:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   for (i = 0U; i <= tot; i++)
 680:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   {
 681:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Initialize sum with zero to carry on MAC operations */
 682:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     sum = 0;
 683:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 684:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Loop to perform MAC operations according to convolution equation */
 685:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     for (j = 0U; j <= i; j++)
 686:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     {
 687:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****       /* Check the array limitations */
 688:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****       if ((((i - j) < srcBLen) && (j < srcALen)))
 689:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****       {
 690:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****         /* z[i] += x[i-j] * y[j] */
 691:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****         sum += ((q31_t) pIn1[j] * pIn2[-((int32_t) i - j)]);
 692:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****       }
 693:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     }
 694:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     /* Store the output in the destination buffer */
 695:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     if (inv == 1)
 696:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****       *pDst-- = (q15_t) __SSAT((sum >> 15U), 16U);
 697:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****     else
 698:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****       *pDst++ = (q15_t) __SSAT((sum >> 15U), 16U);
 699:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c ****   }
 700:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 701:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** #endif /* #if (defined(ARM_MATH_CM7) || defined(ARM_MATH_CM4) || defined(ARM_MATH_CM3)) && !defined
 702:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** 
 703:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_correlate_q15.c **** }
