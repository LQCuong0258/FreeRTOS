  77:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* Run the below code for Cortex-M4 and Cortex-M3 */
  78:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
  79:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t *pIn1;                                   /* inputA pointer */
  80:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t *pIn2;                                   /* inputB pointer */
  81:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t *pOut = pDst;                            /* output pointer */
  82:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t *px;                                     /* Intermediate inputA pointer  */
  83:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t *py;                                     /* Intermediate inputB pointer  */
  84:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t *pSrc1, *pSrc2;                          /* Intermediate pointers */
  85:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q63_t sum;                                     /* Accumulator */
  86:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q63_t acc0, acc1, acc2;                        /* Accumulator */
  87:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   q31_t x0, x1, x2, c0;                          /* Temporary variables to hold state and coefficie
  88:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   uint32_t j, k, count, blkCnt, blockSize1, blockSize2, blockSize3;     /* loop counter */
  89:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
  90:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* The algorithm implementation is based on the lengths of the inputs. */
  91:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* srcB is always made to slide across srcA. */
  92:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* So srcBLen is always considered as shorter or equal to srcALen */
  93:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   if (srcALen >= srcBLen)
  94:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   {
  95:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* Initialization of inputA pointer */
  96:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     pIn1 = pSrcA;
  97:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
  98:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* Initialization of inputB pointer */
  99:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     pIn2 = pSrcB;
 100:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   }
 101:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   else
 102:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   {
 103:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* Initialization of inputA pointer */
 104:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     pIn1 = (q31_t *) pSrcB;
 105:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 106:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* Initialization of inputB pointer */
 107:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     pIn2 = (q31_t *) pSrcA;
 108:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 109:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* srcBLen is always considered as shorter or equal to srcALen */
 110:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     j = srcBLen;
 111:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     srcBLen = srcALen;
 112:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     srcALen = j;
 113:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   }
 114:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 115:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* conv(x,y) at n = x[n] * y[0] + x[n-1] * y[1] + x[n-2] * y[2] + ...+ x[n-N+1] * y[N -1] */
 116:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* The function is internally
 117:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * divided into three stages according to the number of multiplications that has to be
 118:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * taken place between inputA samples and inputB samples. In the first stage of the
 119:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * algorithm, the multiplications increase by one for every iteration.
 120:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * In the second stage of the algorithm, srcBLen number of multiplications are done.
 121:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * In the third stage of the algorithm, the multiplications decrease by one
 122:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * for every iteration. */
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\cca56dE2.s 			page 4


 123:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 124:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* The algorithm is implemented in three stages.
 125:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****      The loop counters of each stage is initiated here. */
 126:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   blockSize1 = srcBLen - 1U;
 127:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   blockSize2 = srcALen - (srcBLen - 1U);
 128:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   blockSize3 = blockSize1;
 129:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 130:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* --------------------------
 131:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * Initializations of stage1
 132:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * -------------------------*/
 133:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 134:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* sum = x[0] * y[0]
 135:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * sum = x[0] * y[1] + x[1] * y[0]
 136:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * ....
 137:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * sum = x[0] * y[srcBlen - 1] + x[1] * y[srcBlen - 2] +...+ x[srcBLen - 1] * y[0]
 138:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    */
 139:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 140:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* In this stage the MAC operations are increased by 1 for every iteration.
 141:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****      The count variable holds the number of MAC operations performed */
 142:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   count = 1U;
 143:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 144:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* Working pointer of inputA */
 145:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   px = pIn1;
 146:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 147:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* Working pointer of inputB */
 148:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   py = pIn2;
 149:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 150:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 151:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* ------------------------
 152:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * Stage1 process
 153:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****    * ----------------------*/
 154:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 155:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   /* The first stage starts here */
 156:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   while (blockSize1 > 0U)
 157:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****   {
 158:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* Accumulator is made zero for every iteration */
 159:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     sum = 0;
 160:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 161:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* Apply loop unrolling and compute 4 MACs simultaneously. */
 162:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     k = count >> 2U;
 163:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 164:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* First part of the processing with loop unrolling.  Compute 4 MACs at a time.
 165:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****      ** a second loop below computes MACs for the remaining 1 to 3 samples. */
 166:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     while (k > 0U)
 167:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     {
 168:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       /* x[0] * y[srcBLen - 1] */
 169:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       sum += (q63_t) * px++ * (*py--);
 170:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       /* x[1] * y[srcBLen - 2] */
 171:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       sum += (q63_t) * px++ * (*py--);
 172:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       /* x[2] * y[srcBLen - 3] */
 173:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       sum += (q63_t) * px++ * (*py--);
 174:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       /* x[3] * y[srcBLen - 4] */
 175:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       sum += (q63_t) * px++ * (*py--);
 176:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 177:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       /* Decrement the loop counter */
 178:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       k--;
 179:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     }
ARM GAS  C:\Users\Lamp\AppData\Local\Temp\cca56dE2.s 			page 5


 180:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 181:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     /* If the count is not a multiple of 4, compute any remaining MACs here.
 182:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****      ** No loop unrolling is used. */
 183:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     k = count % 0x4U;
 184:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
 185:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     while (k > 0U)
 186:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****     {
 187:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       /* Perform the multiply-accumulate */
 188:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c ****       sum += (q63_t) * px++ * (*py--);
 189:Drivers/CMSIS/DSP/Source/FilteringFunctions/arm_conv_q31.c **** 
