  79:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_mean_q31.c ****   {
  80:Drivers/CMSIS/DSP/Source/StatisticsFunctions/arm_mean_q31.c ****     /* C = (A[0] + A[1] + A[2] + ... + A[blockSize-1]) */
